{
	"schemaVersion": 1,
	"id": "discordbridge",
	"version": "${version}",
	"name": "Discord Bridge",
	"description": "Bridges Minecraft chat, player events, advancements, and images with Discord.",
	"license": "CC0-1.0",
	"icon": "assets/discordbridge/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jackyon.Discordbridge"
		],
		"client": [
			"com.jackyon.client.DiscordbridgeClient"
		]
	},
	"mixins": [
		"discordbridge.mixins.json",
		{
			"config": "discordbridge.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
